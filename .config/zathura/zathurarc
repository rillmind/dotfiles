# set default-bg "#ffffff"
# set statusbar-bg "#1e1e2e"
# set statusbar-fg "#cdd6f4"

# tema do quickshell (tema-ativo → ~/.local/state/quickshell/aparencia/zathura)
include tema-ativo

set pages-per-row-spacing 1
set pages-per-row 1
set scroll-page-aware true
set scroll-full-overlap 0.01

# Isso faz com que selecionar um texto mande direto 
# para a área de transferência em sistemas wayland
# usando o wl-copy, pacote que faz justamente o que
# eu expliquei acima.
set selection-clipboard clipboard
