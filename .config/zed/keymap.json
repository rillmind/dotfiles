[
  // Definir como navegar pelas abas
  {
    "context": "Pane",
    "bindings": {
      "ctrl-1": ["pane::ActivateItem", 0],
      "ctrl-2": ["pane::ActivateItem", 1],
      "ctrl-3": ["pane::ActivateItem", 2],
      "ctrl-4": ["pane::ActivateItem", 3],
      "ctrl-5": ["pane::ActivateItem", 4],
      "ctrl-6": ["pane::ActivateItem", 5],
      "ctrl-7": ["pane::ActivateItem", 6],
      "ctrl-8": ["pane::ActivateItem", 7],
      "ctrl-9": ["pane::ActivateItem", 8],
      "ctrl-0": "pane::ActivateLastItem",
    },
  },

  // Fechar aba
  {
    "context": "Pane",
    "bindings": {
      "ctrl-q": "pane::CloseActiveItem",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-q": "pane::CloseActiveItem",
    },
  },

  // Explorador de arquivos
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "d": "project_panel::Trash",
      "r": "project_panel::Rename",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-e": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-e": "workspace::ToggleRightDock",
    },
  },

  // Agentes de IA
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-i": "agent::ToggleFocus",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-i": "agent::ToggleFocus",
    },
  },

  // Ações de código
  {
    "context": "Editor",
    "bindings": {
      "ctrl-.": "editor::ToggleCodeActions",
    },
  },

  // Abrir arquivo de atalhos
  {
    "bindings": {
      "ctrl-alt-<": "zed::OpenKeymapFile",
    },
  },

  // Limpar notificações
  {
    "bindings": {
      "ctrl-alt-shift-v": "workspace::ClearAllNotifications",
    },
  },

  // Editando atalhos do vim_mode
  {
    "context": "vim_mode == normal",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
      "$": ["workspace::SendKeystrokes", "g $"],
      "0": ["workspace::SendKeystrokes", "g 0"],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
      "$": ["workspace::SendKeystrokes", "g $"],
      "0": ["workspace::SendKeystrokes", "g 0"],
    },
  },

  // Terminal
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-'": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-'": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-'": "terminal_panel::Toggle",
    },
  },

  // Bottom Dock
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-alt-'": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-'": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-alt-'": "workspace::ToggleBottomDock",
    },
  },
]
