#Bashtop vinho (https://github.com/morhetz/vinho) theme
#by BachoSeven

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#f6e9e2", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#15070d"

# Main text color
theme[main_fg]="#b08d94"

# Title color for boxes
theme[title]="#e8d5cf"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c08d4a"

# Background color of selected items
theme[selected_bg]="#1c0b12"

# Foreground color of selected items
theme[selected_fg]="#d9a862"

# Color of inactive/disabled text
theme[inactive_fg]="#1c0b12"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#5f2c3c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#87925f"

# Cpu box outline color
theme[cpu_box]="#b08d94"

# Memory/disks box outline color
theme[mem_box]="#b08d94"

# Net up/down box outline color
theme[net_box]="#b08d94"

# Processes box outline color
theme[proc_box]="#b08d94"

# Box divider line and small boxes line color
theme[div_line]="#b08d94"

# Temperature graph colors
theme[temp_start]="#7686a6"
theme[temp_mid]="#c99ab8"
theme[temp_end]="#c4527a"

# CPU graph colors
theme[cpu_start]="#a3ad7a"
theme[cpu_mid]="#c08d4a"
theme[cpu_end]="#e0566f"

# Mem/Disk free meter
theme[free_start]="#4a1d2c"
theme[free_mid]=""
theme[free_end]="#87925f"

# Mem/Disk cached meter
theme[cached_start]="#7686a6"
theme[cached_mid]=""
theme[cached_end]="#93a3c0"

# Mem/Disk available meter
theme[available_start]="#c08d4a"
theme[available_mid]=""
theme[available_end]="#d9a862"

# Mem/Disk used meter
theme[used_start]="#b03a52"
theme[used_mid]=""
theme[used_end]="#e0566f"

# Download graph colors
theme[download_start]="#35151f"
theme[download_mid]="#7686a6"
theme[download_end]="#93a3c0"

# Upload graph colors
theme[upload_start]="#5a2236"
theme[upload_mid]="#a0729a"
theme[upload_end]="#c99ab8"
