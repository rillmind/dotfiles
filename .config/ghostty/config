# This is the configuration file for Ghostty.

command = /bin/zsh

confirm-close-surface = false

window-decoration = none

theme = catppuccin-mocha.conf
# o tema do quickshell sobrescreve a linha acima (tema-ativo → ~/.local/state/quickshell/aparencia/ghostty)
config-file = ?tema-ativo
# sem o aviso "configuração recarregada" a cada troca de tema
app-notifications = no-config-reload

font-size = 17

font-family = JetbrainsMono Nerd Font
# cantos dos quadrados da barra do tmux (~/.config/tmux/fonte)
font-codepoint-map = U+F8E0-U+F8E1=Tmux Cantos
font-codepoint-map = U+F8C0-U+F8C9,U+F8D0-U+F8DB,U+F8E2-U+F8ED=Tmux Lateral

mouse-hide-while-typing

shell-integration-features = no-cursor

cursor-style = block_hollow

cursor-style-blink = true

adjust-cell-width = 0

# esquerda,direita em pontos (aqui 1 px e 10 px): a folga à direita acompanha o respiro de 14 px que a
# divisória da barra lateral do tmux deixa à esquerda do texto; a sobra de células soma à direita
window-padding-x = 1,8
window-padding-y = 0

# não centraliza a sobra: com balance, ela vira uma faixa no topo e embaixo
window-padding-balance = false

# Cola texto e avisa o tmux, que cola imagem no Claude Code (ver ~/.scripts/linux/tmux-paste-image.sh)
keybind = ctrl+shift+v=paste_from_clipboard
keybind = chain=csi:9999~

