import QtQuick
import QtQuick.Layouts
import "."

// ControlCenter.qml – NOVO widget substituto
// Mantém API externa idêntica (volumeLevel, volumeMuted, networkIcon/Tooltip, battery*)
// para não quebrar shell.qml:279-298. Apenas muda layout interno:
//   topo = NetworkStatusWidget circular (wifi + dots em arco = volume%)
//   embaixo = infos: nome wifi | volume atual | bateria %
//   + slider e botões (mute/atualizar)
// Barra superior (shell.qml bar) permanece exatamente como está.

Rectangle {
    id: rootCC
    property int volumeLevel: 35
    property bool volumeMuted: false
    property string networkIcon: "󰤭 "
    property string networkTooltip: "Desconectado"
    property string batteryIcon: " "
    property int batteryCapacity: 100
    property string batteryStatus: "Not charging"
    property bool batteryCharging: false
    property string fontFamily: "JetBrainsMono Nerd Font"
    property color colText: "#cdd6f4"
    property color colSurface0: "#313244"
    property color colSurface1: "#45475a"
    property color colMauve: "#cba6f7"
    property color colBarBg: "#1e1e2e"
    signal requestSetVolume(int level)
    signal requestToggleMute()
    signal requestRefresh()

    // novo tamanho: mais alto para acomodar ícone circular + infos
    width: 520
    height: 210
    radius: 12
    color: colBarBg
    border.color: colSurface0
    border.width: 1

    // estado derivado para o widget circular
    // scanning = quando desconectado (mostra onda nos dots acesos)
    property string widgetState: networkTooltip === "Desconectado" || networkIcon === "󰤭 " ? "disconnected" : "connected"
    // se quiser simular scanning futuro, basta trocar para "scanning" via prop externa

    ColumnLayout {
        anchors.fill: parent
        anchors.margins: 14
        spacing: 10

        // ── Topo: widget circular centralizado ───────────────────
        Item {
            Layout.fillWidth: true
            Layout.preferredHeight: 92
            // centraliza o widget
            NetworkStatusWidget {
                id: netWidget
                anchors.centerIn: parent
                widgetSize: 84
                primaryColor: rootCC.colMauve
                backgroundColor: rootCC.colBarBg
                surfaceColor: rootCC.colSurface0
                borderColor: rootCC.colSurface0
                textColor: rootCC.colText
                dotCount: 10
                animationDuration: 1200
                // dots = volume%; estado = disconnected mostra borda vermelha + wifi vermelho
                state: rootCC.widgetState
                volumeLevel: rootCC.volumeLevel
                volumeMuted: rootCC.volumeMuted
            }
        }

        // ── Infos embaixo do ícone: wifi | volume | bateria ──────
        RowLayout {
            Layout.fillWidth: true
            spacing: 0

            // WiFi nome
            ColumnLayout {
                Layout.fillWidth: true
                spacing: 1
                Text {
                    text: "Wi-Fi"
                    color: colText; opacity: 0.6
                    font.family: fontFamily; font.pixelSize: 9; font.bold: true
                    Layout.fillWidth: true; horizontalAlignment: Text.AlignHCenter
                }
                Text {
                    text: networkTooltip === "" || networkTooltip === "Desconectado" ? "Desconectado" : networkTooltip
                    color: networkTooltip === "Desconectado" ? "#f38ba8" : colText
                    font.family: fontFamily; font.pixelSize: 11; font.bold: true
                    elide: Text.ElideRight; Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                    maximumLineCount: 1
                }
                Text {
                    text: networkIcon === "󰤨 " ? "󰤨 Wi-Fi" : networkIcon === " " ? " Ethernet" : "󰤭 Sem rede"
                    color: colText; opacity: 0.7
                    font.family: fontFamily; font.pixelSize: 9
                    Layout.fillWidth: true; horizontalAlignment: Text.AlignHCenter
                }
            }

            Rectangle { Layout.preferredWidth: 1; Layout.fillHeight: true; Layout.topMargin: 4; Layout.bottomMargin: 4; color: colSurface0; opacity: 0.55 }

            // Volume %
            ColumnLayout {
                Layout.fillWidth: true
                spacing: 1
                Text {
                    text: "Volume"
                    color: colText; opacity: 0.6
                    font.family: fontFamily; font.pixelSize: 9; font.bold: true
                    Layout.fillWidth: true; horizontalAlignment: Text.AlignHCenter
                }
                Text {
                    text: volumeMuted ? "Mudo" : volumeLevel + "%"
                    color: volumeMuted ? "#f38ba8" : colText
                    font.family: fontFamily; font.pixelSize: 13; font.bold: true
                    Layout.fillWidth: true; horizontalAlignment: Text.AlignHCenter
                }
                Text {
                    text: volumeMuted ? " mutado" : (volumeLevel < 33 ? " baixo" : volumeLevel < 66 ? " médio" : " alto")
                    color: colText; opacity: 0.7
                    font.family: fontFamily; font.pixelSize: 9
                    Layout.fillWidth: true; horizontalAlignment: Text.AlignHCenter
                }
            }

            Rectangle { Layout.preferredWidth: 1; Layout.fillHeight: true; Layout.topMargin: 4; Layout.bottomMargin: 4; color: colSurface0; opacity: 0.55 }

            // Bateria %
            ColumnLayout {
                Layout.fillWidth: true
                spacing: 1
                Text {
                    text: "Bateria"
                    color: colText; opacity: 0.6
                    font.family: fontFamily; font.pixelSize: 9; font.bold: true
                    Layout.fillWidth: true; horizontalAlignment: Text.AlignHCenter
                }
                RowLayout {
                    Layout.alignment: Qt.AlignHCenter
                    spacing: 4
                    Text {
                        text: batteryIcon.replace("󱐋","").trim()
                        color: batteryCharging ? colMauve : colText
                        font.family: fontFamily; font.pixelSize: 13; font.bold: true
                    }
                    Text {
                        text: batteryCapacity + "%"
                        color: colText; font.family: fontFamily; font.pixelSize: 13; font.bold: true
                    }
                    Text {
                        text: batteryCharging ? "󱐋" : ""
                        color: colMauve; font.family: fontFamily; font.pixelSize: 12; font.bold: true
                        visible: batteryCharging
                    }
                }
                Text {
                    text: batteryStatus
                    color: colText; opacity: 0.7
                    font.family: fontFamily; font.pixelSize: 9
                    elide: Text.ElideRight; Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                    maximumLineCount: 1
                }
            }
        }

        // ── Slider volume (dots já mostram %, slider mantém controle fino) ──
        Rectangle {
            id: track
            Layout.fillWidth: true
            Layout.preferredHeight: 6
            radius: 4
            color: colSurface0
            Layout.topMargin: 2
            property real ratio: Math.max(0, Math.min(1, volumeLevel / 100.0))
            Rectangle { height: parent.height; radius: parent.radius; width: parent.width * track.ratio; color: colMauve; opacity: volumeMuted ? 0.35 : 1.0 }
            Rectangle {
                width: 14; height: 14; radius: 7
                color: colText; border.color: colMauve; border.width: 2
                x: Math.max(0, Math.min(track.width - width, track.width * track.ratio - width/2))
                anchors.verticalCenter: parent.verticalCenter
                opacity: volumeMuted ? 0.6 : 1.0
            }
            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onPressed: updatePos(mouse.x)
                onPositionChanged: if (pressed) updatePos(mouse.x)
                function updatePos(x) {
                    var r = Math.max(0, Math.min(1, x / track.width))
                    rootCC.requestSetVolume(Math.round(r * 100))
                }
            }
        }

        // ── Botões ───────────────────────────────────────────────
        RowLayout {
            Layout.fillWidth: true
            spacing: 8
            Layout.topMargin: 1

            Rectangle {
                Layout.fillWidth: true
                Layout.preferredHeight: 26
                radius: 6
                color: volumeMuted ? colMauve : colSurface0
                Text {
                    anchors.centerIn: parent
                    text: volumeMuted ? "Mutado" : "Som"
                    color: volumeMuted ? colBarBg : colText
                    font.family: fontFamily; font.pixelSize: 11; font.bold: true
                }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: rootCC.requestToggleMute() }
            }

            Rectangle {
                Layout.fillWidth: true
                Layout.preferredHeight: 26
                radius: 6
                color: colSurface0
                Text {
                    anchors.centerIn: parent
                    text: "Atualizar"
                    color: colText; font.family: fontFamily; font.pixelSize: 11; font.bold: true
                }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: rootCC.requestRefresh() }
            }
        }
    }
}
