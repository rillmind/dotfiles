// Menuzinho da bandeja, logo acima da barra. O vinho.sh preenche os @...@ e a abre escondido.
{
  "output": "@MONITOR@",
  "layer": "overlay",
  "position": "bottom",
  "exclusive": false,
  "start_hidden": true,
  "height": 40,
  // só os ~400px da direita, para a parte transparente não cobrir a tela
  "margin-left": @MARGEM@,
  "margin-right": 4,
  "margin-bottom": 4,
  "modules-right": ["tray"],
  "tray": { "icon-size": 18, "spacing": 14, "show-passive-items": true }
}
