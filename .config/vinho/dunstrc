# Notificações do tema Vinho
[global]
    width = (0, 360)
    height = (0, 200)
    origin = bottom-right
    offset = (8, 34)
    frame_width = 2
    frame_color = "#8c2f4b"
    separator_color = frame
    corner_radius = 0
    padding = 10
    horizontal_padding = 12
    font = JetBrains Mono, JetBrainsMono Nerd Font 11
    max_icon_size = 40

[urgency_low]
    background = "#1c0b12"
    foreground = "#b08d94"
    timeout = 5
[urgency_normal]
    background = "#1c0b12"
    foreground = "#e8d5cf"
    timeout = 5
[urgency_critical]
    background = "#35151f"
    foreground = "#f6e9e2"
    frame_color = "#e0566f"
    timeout = 0
