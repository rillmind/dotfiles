window,
.view,
headerbar,
.dialog-stack,
.adw-status-page,
statuspage {
  background-color: #1e1e2e;
  color: #cdd6f4;
}

window.dialog,
window.dialog > box,
window.dialog headerbar,
window.dialog list {
  background-color: #181825;
}

window.dialog row {
  background-color: #313244;
}

popover contents,
popover arrow {
  background-color: #181825;
  border: 1px solid #313244;
}

row:hover,
list > row:selected {
  background-color: #1e1e2e;
  color: #cdd6f4;
  border-radius: 10px;
}

.navigation-sidebar {
  background-color: #313244;
  color: #cdd6f4;
}

popover,
popover contents,
popover list,
popover row {
  background-color: #1e1e2e;
  color: #cdd6f4;
  border: none;
  box-shadow: none;
  border-radius: 10px;
}

popover contents {
  border: 3px solid #45475a;
  padding: 8px;
}

popover row:hover {
  background-color: #cba6f7;
  color: #1e1e2e;
  border-radius: 10px;
}

popover separator {
  background-color: #313244;
  margin: 4px 0;
}
